# Copy to .env (never commit it).
# OPENROUTER_API_KEY is not set here: it is read from the machine's environment.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Retriever for the chat route and scripts.eval_retrieval: vector (dense only) or hybrid (dense + keyword, RRF). An unknown value stops the server at startup.
RETRIEVER_MODE=vector

# Spend caps in OpenRouter credits: the UI warns at the soft cap, the backend refuses requests at the hard cap.
BUDGET_SOFT_CREDITS=1
BUDGET_HARD_CREDITS=4

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=sound_companion
# Values for running on the host; compose overrides host and port for the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=7001

# Backend address (it binds here; the client proxies /api to it). Compose overrides the host per service.
BACKEND_HOST=localhost

# Ports on the host: backend, client (the database uses POSTGRES_PORT).
BACKEND_PORT=7002
CLIENT_PORT=7003
