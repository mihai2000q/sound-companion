# Copy to .env (never commit it).
# OPENROUTER_API_KEY is not set here: it is read from the machine's environment.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=sound_companion
# Values for running on the host; compose overrides host and port for the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=7001

# Ports on the host: backend, client (the database uses POSTGRES_PORT).
BACKEND_PORT=7002
CLIENT_PORT=7003
